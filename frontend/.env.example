NEXT_PUBLIC_API_URL=https://dewordle.onrender.com/api/v1

# Feature flags — set to "true" to enable incomplete surfaces
NEXT_PUBLIC_FEATURE_REWARDS=false
NEXT_PUBLIC_FEATURE_ACHIEVEMENTS=false

# Content Security Policy (see src/lib/csp.ts)
# Where the browser POSTs violation reports (default: /api/csp-report).
# NEXT_PUBLIC_CSP_REPORT_URI=/api/csp-report
# Forward reports received at /api/csp-report to a collector.
# CSP_REPORT_FORWARD_URL=
# Extra comma-separated origins to allow in script-src / connect-src.
# NEXT_PUBLIC_CSP_SCRIPT_ORIGINS=
# NEXT_PUBLIC_CSP_CONNECT_ORIGINS=
